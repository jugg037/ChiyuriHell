<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hell_black"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="CHIYURIHELL"
            android:textColor="@color/hell_bright_red"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="ЗАЩИЩЁННЫЙ ДОСТУП. БЕЗОПАСНОСТЬ ПРЕЖДЕ ВСЕГО."
            android:textColor="@color/hell_muted"
            android:textSize="11sp"
            android:letterSpacing="0.06" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@color/hell_panel"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ИМПОРТИРУЙТЕ ПРОФИЛЬ"
                android:textColor="@color/hell_bright_red"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/profileStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Полнотуннельный режим ALL • WireGuard"
                android:textColor="@color/hell_muted"
                android:textSize="13sp" />
            <Button
                android:id="@+id/importButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/hell_panel"
                android:text="ИМПОРТИРОВАТЬ ПРОФИЛЬ .CONF"
                android:textColor="@color/hell_text"
                android:textStyle="bold" />
            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/hell_red"
                android:enabled="false"
                android:text="ПОДКЛЮЧИТЬСЯ"
                android:textColor="@color/hell_text"
                android:textStyle="bold" />
            <Button
                android:id="@+id/removeProfileButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/hell_panel"
                android:enabled="false"
                android:text="УДАЛИТЬ СОХРАНЁННЫЙ ПРОФИЛЬ"
                android:textColor="@color/hell_bright_red"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="ПРОВЕРКИ РЕЖИМА ALL"
            android:textColor="@color/hell_bright_red"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/hell_panel"
            android:padding="16dp"
            android:text="• IPv4 и IPv6 адреса интерфейса&#10;• Маршруты 0.0.0.0/0 и ::/0&#10;• DNS-сервер в профиле&#10;• Без исключённых приложений&#10;• Один проверяемый WireGuard peer"
            android:textColor="@color/hell_text"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Профиль хранится в зашифрованном виде с ключом Android Keystore. Системная блокировка трафика при обрыве VPN пока не реализована: после разрыва Android может использовать обычную сеть. Не используйте неизвестные серверы для чувствительных данных."
            android:textColor="@color/hell_muted"
            android:textSize="12sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="CHIYURIHELL • OPEN SOURCE"
            android:textColor="@color/hell_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
