<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hell_black"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="CHIYURIHELL"
            android:textColor="@color/hell_bright_red"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="ЗАЩИЩЁННЫЙ ДОСТУП. БЕЗОПАСНОСТЬ ПРЕЖДЕ ВСЕГО."
            android:textColor="@color/hell_muted"
            android:textSize="11sp"
            android:letterSpacing="0.06" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:background="@color/hell_panel"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ИНФРАСТРУКТУРА НЕ НАСТРОЕНА"
                android:textColor="@color/hell_bright_red"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Полнотуннельный режим ALL&#10;Серверная политика MIXED"
                android:textColor="@color/hell_text"
                android:textSize="14sp" />
            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="@color/hell_red"
                android:enabled="false"
                android:text="ПОДКЛЮЧИТЬСЯ"
                android:textColor="@color/hell_text"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Подключение станет доступно после интеграции проверенного VPN-ядра и серверных профилей."
                android:textColor="@color/hell_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="СОСТОЯНИЕ ПРОЕКТА"
            android:textColor="@color/hell_bright_red"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/hell_panel"
            android:padding="16dp"
            android:text="✓ Android 10+&#10;✓ Основа интерфейса&#10;✓ Декларация Android VPN Service&#10;• VPN-ядро: в разработке&#10;• Каталог доверенных серверов: в разработке&#10;• Защита от утечек и аварийная блокировка: впереди"
            android:textColor="@color/hell_text"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="CHIYURIHELL • OPEN SOURCE"
            android:textColor="@color/hell_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
